import { test, expect } from '@playwright/test';

async function ready(page: import('@playwright/test').Page) {
  await page.goto('/#portfolio');
  const links = page.locator('.projectLink');
  for (const index of [0, 1]) {
    const link = links.nth(index);
    await link.scrollIntoViewIfNeeded();
    await link.locator('img').evaluate(image => (image as HTMLImageElement).decode());
    await link.hover();
    await expect(link.locator('.visual')).toHaveAttribute('data-webgl-artwork', 'active');
    await page.mouse.move(1, 1);
    await expect(page.locator('.visual[data-webgl-artwork="active"]')).toHaveCount(0);
  }
  return links;
}

test('thumbnail handoff interpolates and rapid card changes preserve an animated exit', async ({ page }, info) => {
  test.skip(info.project.name !== 'desktop', 'Mouse-follow motion is reserved for fine desktop pointers.');
  const links = await ready(page), first = links.nth(0), second = links.nth(1);
  await first.hover();
  await expect.poll(() => first.locator('img').evaluate(el => Number(getComputedStyle(el).opacity))).toBe(0);
  await second.hover();
  await expect(second.locator('.visual')).toHaveAttribute('data-webgl-artwork', 'active');
  // Switching targets must let the old card settle instead of immediately restoring it.
  await expect(first.locator('.visual')).toHaveAttribute('data-webgl-artwork', 'active');
  await expect(page.locator('.portfolioWebgl')).toHaveAttribute('data-card-views', '2');
  await first.hover();
  const samples = await first.locator('.visual').evaluate(el => new Promise<{ scale: number; active: boolean }[]>(resolve => {
    const values: { scale: number; active: boolean }[] = [], start = performance.now();
    function sample() { const node = el as HTMLElement; values.push({ scale: Number(node.dataset.webglScale), active: node.dataset.webglArtwork === 'active' }); if (performance.now() - start < 450) requestAnimationFrame(sample); else resolve(values); }
    requestAnimationFrame(sample);
  }));
  // The native layer may already be visible beneath the opaque GPU plane. Verify
  // the actual 3D pose continues instead of inferring it from native-image opacity.
  expect(samples.every(sample => sample.active && sample.scale >= .955 && sample.scale <= .985)).toBe(true);
  expect(Math.max(...samples.slice(1).map((sample, index) => Math.abs(sample.scale - samples[index].scale)))).toBeLessThan(.014);
  await page.mouse.move(1, 1);
  await expect(page.locator('.visual[data-webgl-artwork="active"]')).toHaveCount(0);
  await expect.poll(() => first.locator('img').evaluate(el => getComputedStyle(el).opacity)).toBe('1');
  await expect(page.locator('.portfolioWebgl')).toHaveAttribute('data-card-views', '0');
  // The shared renderer may keep a visible hero running. Move it fully offscreen
  // before checking that the now-idle thumbnail work stops requesting frames.
  await page.locator('.projectGrid').evaluate(el => el.scrollIntoView({ block: 'start', behavior: 'instant' }));
  await expect(page.locator('.portfolioWebgl')).toHaveAttribute('data-state', 'paused');
  expect(await first.locator('.visual').evaluate(el => (el as HTMLElement).style.getPropertyValue('--webgl-dom-opacity'))).toBe('');
});

test('a warm thumbnail has intermediate crossfade frames without a one-frame visibility jump', async ({ page }, info) => {
  test.skip(info.project.name !== 'desktop', 'Mouse-follow motion is reserved for fine desktop pointers.');
  const links = await ready(page), link = links.first(), box = (await link.locator('.visual').boundingBox())!;
  const capture = link.locator('img').evaluate(el => new Promise<number[]>(resolve => {
    const values: number[] = [], start = performance.now();
    function sample() { values.push(Number(getComputedStyle(el).opacity)); if (performance.now() - start < 750) requestAnimationFrame(sample); else resolve(values); }
    requestAnimationFrame(sample);
  }));
  await page.mouse.move(box.x + box.width * .8, box.y + box.height * .35);
  const values = await capture;
  expect(values.filter(v => v > .01 && v < .99).length).toBeGreaterThan(3);
  expect(Math.max(...values.slice(1).map((v, i) => Math.abs(v - values[i])))).toBeLessThan(.55);
  await page.mouse.move(1, 1);
  await expect(page.locator('.visual[data-webgl-artwork="active"]')).toHaveCount(0);
});

test('touch and reduced-motion preferences retain stable readable thumbnails', async ({ page }) => {
  await page.emulateMedia({ reducedMotion: 'reduce' });
  await page.goto('/#portfolio');
  const link = page.locator('.projectLink').first();
  await link.scrollIntoViewIfNeeded();
  await link.hover();
  await expect(page.locator('html')).toHaveAttribute('data-motion', 'reduced');
  await expect(page.locator('.visual[data-webgl-artwork="active"]')).toHaveCount(0);
  expect(await link.locator('img').evaluate(el => ({ opacity: getComputedStyle(el).opacity, fit: getComputedStyle(el).objectFit }))).toEqual({ opacity: '1', fit: 'contain' });
});
