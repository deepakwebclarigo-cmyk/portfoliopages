{"type":"before","callId":"gfsl@895","startTime":142299.829,"class":"Frame","method":"evalOnSelectorAll","params":{"selector":".projectArt img","expression":"images => images.map(element => {\n    const image = element,\n      style = getComputedStyle(image),\n      box = image.getBoundingClientRect(),\n      frame = image.closest('.visual').getBoundingClientRect();\n    const scale = Math.min(box.width / image.naturalWidth, box.height / image.naturalHeight);\n    const paintedWidth = image.naturalWidth * scale,\n      paintedHeight = image.naturalHeight * scale;\n    const matrix = new DOMMatrixReadOnly(style.transform);\n    return {\n      fit: style.objectFit,\n      position: style.objectPosition,\n      uniform: Math.abs(matrix.m11 - matrix.m22) < .001 && matrix.m11 >= .95 && matrix.m11 <= 1,\n      inside: paintedWidth <= frame.width + 1 && paintedHeight <= frame.height + 1,\n      centered: Math.abs(box.x + box.width / 2 - frame.x - frame.width / 2) < 1 && Math.abs(box.y + box.height / 2 - frame.y - frame.height / 2) < 1\n    };\n  })","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
