/* Shared refinements preserve the existing grid, type scale, and brand identity. */
:root { --accent: #ea1b3d; --accent-dark: #c91839; --soft: #6f7481; }
/* A slightly deeper brand red keeps small white button labels above 4.5:1. */
.navCta, .buttonPrimary { background: #e3193b; }
html { scrollbar-gutter: stable; }
.visualPicture { position: absolute; inset: 0; z-index: 2; display: block; width: 100%; height: 100%; }
main:focus { outline: none; }
.heroScroll, .resultMeta, .projectType, .caseMeta span, .sectionLabel, .relatedCard>span, .siteFooter { color: var(--muted); }
.sectionLabel>span { color: var(--accent-dark); }
.desktopNav a:hover, .mobileNav nav a:hover, .backLink:hover, .artworkCaption a:hover, .relatedHeading>a:hover, .archiveLink:hover { color: var(--accent-dark); }
.filterPill span { opacity: 1; font-size: 11px; }
.searchField, .searchField input::placeholder { color: var(--muted); }
.searchField { border-color: #858a97; }
.projectType, .relatedCard>span, .caseMeta span { font-size: 11px; letter-spacing: .7px; }
.searchField:focus-within { box-shadow: 0 0 0 3px #ea1b3d12; }
.caseNav a { min-height: 44px; }
.galleryDialogBar>span { min-width: 0; overflow-wrap: anywhere; }
.galleryDialogBar>div { flex-shrink: 0; }
.galleryDialogBar button { width: 44px; height: 44px; }
.caseNav a:focus-visible, .filterPill:focus-visible, .galleryOpen:focus-visible { outline-offset: -4px; }
.projectGallery:not(.singleImageGallery) .galleryComposition { aspect-ratio: 1.2; }
.emptyState p { margin-top: 0; }
.resetFilters { min-height: 44px; padding: 10px 18px; border: 1px solid var(--line); border-radius: 999px; background: white; color: var(--ink); font-size: 14px; font-weight: 500; transition: border-color .2s ease, color .2s ease; }
.resetFilters:hover { border-color: var(--accent); color: var(--accent-dark); }
@media (max-width: 700px) { .searchField input { font-size: 16px; } }
@media (forced-colors: active) {
  .filterPill.isActive, .caseNav a[aria-current] { outline: 2px solid Highlight; outline-offset: -4px; }
  .portfolioWebgl { display: none; }
  .heroWebglViewport .heroShowcaseFallback { opacity: 1 !important; }
}
